# Copy to apps/local-api/.env. Do not commit the copy.
# Pooled Neon connection for the development branch. sslmode=require is required.
DATABASE_URL=
NEON_BRANCH=development
# Absolute path of the external firmware archive. Development startup reads this
# and does not embed a machine-specific path in source. An explicit shell value wins.
IOTEDU_FIRMWARE_ARCHIVE=
